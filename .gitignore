#------------------------------------------------------------------------------
# Project-specific ignore rules
#------------------------------------------------------------------------------

# Git submodule and IDE configuration
.gitmodules
.env/
.vscode/
.libs/

# Generated output directories
bin/
out/
target/
build/
dist/
doc/
docs/
docs/_build/

# Python bytecode and cache
__pycache__/
*.py[codz]
*$py.class
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/

# Python environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Python packaging
.Python
*.egg
*.egg-info/
.eggs/
develop-eggs/
wheels/
sdist/
MANIFEST
.installed.cfg

# Test and coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
nosetests.xml
*.cover
*.py.cover

# Distribution and temporary files
downloads/
parts/
share/python-wheels/
*.manifest
*.spec
*.tmp
*.BAK
*.bak
tmp/
temp/

# Logs
log/
logs/
*.log
pip-log.txt
pip-delete-this-directory.txt

# Libraries and archives
lib
libs
lib64/
*.7z
*.gz
*.rar
*.tar
*.tgz
*.tar.gz
*.zip
*.uue*

# Java and IDE files from the original project rules
*.class
*.jar
.classpath
.project
*.iml
.idea

# Branch-related directories
branch/
branches/

# Other development tools
.ipynb_checkpoints
.spyderproject
.spyproject
.ropeproject
.pyre/
.pytype/
.dmypy.json
dmypy.json
cython_debug/
tempCodeRunnerFile.py

# Local-only configuration
.gitconfig

# Operating system files
.DS_Store
